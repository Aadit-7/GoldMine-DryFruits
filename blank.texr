                        "background": "#fef9ef",
                        "error-container": "#ffdad6",
                        "surface-bright": "#fef9ef",
                        "inverse-on-surface": "#f5f0e6",
                        "border-sage": "#C6D5BE",
                        "on-tertiary-fixed-variant": "#653d1e",
                        "on-surface": "#1d1c16",
                        "on-tertiary-container": "#dca57e",
                        "secondary-fixed-dim": "#ffb956",
                        "on-secondary-fixed-variant": "#643f00",
                        "inverse-surface": "#32302a",
                        "tertiary-fixed": "#ffdcc5",
                        "primary-container": "#1f4b3f",
                        "on-primary-container": "#8dbaaa",
                        "text-ink": "#201D17",
                        "nav-dark": "#16332A",
                        "on-surface-variant": "#414845",
                        "surface-container-high": "#ece8de",
                        "on-tertiary-fixed": "#301400",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#e7e2d8",
                        "secondary": "#835400",
                        "surface-container-low": "#f8f3e9",
                        "inverse-primary": "#a2d0c0",
                        "on-background": "#1d1c16",
                        "surface-variant": "#e7e2d8",
                        "secondary-fixed": "#ffddb5",
                        "on-secondary-container": "#714800",
                        "primary-fixed-dim": "#a2d0c0",
                        "tertiary": "#462507",
                        "on-primary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "surface-tint": "#3b6659",
                        "on-secondary": "#ffffff",
                        "error": "#ba1a1a",
                        "on-error-container": "#93000a",
                        "primary-fixed": "#beecdc",
                        "tertiary-fixed-dim": "#f4bb92",
                        "outline": "#717975",
                        "primary": "#023429",
                        "secondary-container": "#feb64e"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "section-gap": "32px",
                        "touch-target": "44px",
                        "gutter-md": "12px",
                        "base": "8px",
                        "container-margin": "16px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "body-sm": ["Inter"],
                        "label-caps": ["Inter"],
                        "headline-lg-mobile": ["\"Source Serif 4\""],
                        "headline-lg": ["\"Source Serif 4\""],
                        "price-mrp": ["Inter"],
                        "title-md": ["Inter"],
                        "price-lg": ["Inter"],
                        "display-lg": ["\"Source Serif 4\""]
                    },
                    "fontSize": {
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                        "price-mrp": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "title-md": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "price-lg": ["22px", { "lineHeight": "28px", "fontWeight": "700" }],
                        "display-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
<style>
        .quality-seal {
            border: 2px dashed #C6D5BE;
            box-shadow: inset 0 2px 4px rgba(2, 52, 41, 0.05);
        }
        .quality-seal:hover {
            border-color: #E8A33D; /* Toasted Amber accent on hover */
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-lg min-h-screen flex flex-col">
<!-- TopNavBar (Shared Component) -->
<header class="w-full sticky top-0 z-50 bg-surface text-primary border-b border-surface-variant shadow-sm transition-all duration-300">
<div class="flex justify-between items-center px-container-margin py-base max-w-[1200px] mx-auto w-full">
<div class="font-headline-lg text-headline-lg text-primary cursor-pointer">Happilo</div>
<nav class="hidden md:flex gap-6 items-center flex-1 justify-center ml-8">
<a class="text-primary font-bold border-b-2 border-secondary font-title-md text-title-md pb-1" href="#">Nuts</a>
<a class="text-on-surface-variant hover:text-primary hover:text-secondary-container transition-colors font-title-md text-title-md pb-1 cursor-pointer active:scale-95 transition-transform" href="#">Berries</a>
<a class="text-on-surface-variant hover:text-primary hover:text-secondary-container transition-colors font-title-md text-title-md pb-1 cursor-pointer active:scale-95 transition-transform" href="#">Dates</a>
