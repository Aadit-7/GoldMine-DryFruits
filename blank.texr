<div class="absolute top-4 left-4 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 rounded-full shadow-md z-10 flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">local_offer</span> 33% OFF
                 </div>
</div>
<!-- Thumbnail Strip -->
<div class="flex md:flex-col gap-4 overflow-x-auto md:overflow-visible pb-2 md:pb-0 w-full md:w-24 shrink-0 snap-x">
<button class="w-20 h-24 md:w-24 md:h-32 bg-surface-sage rounded-lg overflow-hidden border-2 border-primary snap-start focus:outline-none shrink-0 relative shadow-sm">
<img alt="Thumbnail 1" class="w-full h-full object-cover mix-blend-multiply" data-alt="A top-down view of a small handful of perfectly roasted premium almonds scattered artistically on a pristine white marble surface. Warm, bright, and clean studio lighting casts subtle, soft shadows. The overall aesthetic is modern, minimalist, and premium, focusing on the high quality and natural texture of the nuts." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDJI1_QEmbC7e8KH5ePga2OXk-fGlf9h1rkEiBULZth-FkPFRpqH64XSIcPzqZnR00b51ajqyJg5klN30qsk0-xFHA9SnFa-df9nH6zNFd6RBo7TFiQz0R6Qv6l_hZnfm0Oy8eQopgPk3OD84PS8Hyh7AB_cdd9vKCoeGWta92ImYy4lpX1XXC1u4rqbMpnkQ6orIjZ-4ZU-Nq8yadUIakILLw5MgXXeFBbxvg8R76ghm5pxKUY8xDn">
</button>
<button class="w-20 h-24 md:w-24 md:h-32 bg-surface-container rounded-lg overflow-hidden border border-outline-variant hover:border-border-sage transition-colors snap-start focus:outline-none shrink-0 relative opacity-70 hover:opacity-100">
<img alt="Thumbnail 2" class="w-full h-full object-cover mix-blend-multiply" data-alt="A stylized lifestyle shot of an elegant, minimalist glass jar filled with premium roasted almonds, resting on a light oak wooden board against a soft cream background. A sprig of fresh greenery sits slightly out of focus in the foreground to add an organic touch. Soft, diffused lighting enhances the premium, natural vibe." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAO0lQdVixb51sRjd9WsK00KOjN40f0rkNEdlqAJlNpVEZOMBEplLUT1kWZOArXBw8BHyNTbl8ySVYpSdbFU4XoQGofRtdJDMIp0IIFtLw_yLbMs9QaDNIDFecMM7Q7GglcGkrjSnRJBslGYjnVbxWqtZmoU4L0bH0o4vk8oeoN-hvjaCEGnc5xyTVGpVQAbetpYLNXgzy37VVZio8KEnxjOMOsPNIrnKEstJTTRPffGq_FHbbgeJi1">
</button>
<button class="w-20 h-24 md:w-24 md:h-32 bg-surface-container rounded-lg overflow-hidden border border-outline-variant hover:border-border-sage transition-colors snap-start focus:outline-none shrink-0 relative opacity-70 hover:opacity-100">
<img alt="Thumbnail 3" class="w-full h-full object-cover mix-blend-multiply" data-alt="Close-up detail shot focusing on the distinct textured surface and perfect roast level of a single premium Californian almond held gently between two fingers. The background is a clean, blurred warm cream tone to make the subject pop. High-resolution editorial photography style." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDkH25lAYnBhE6K_15zPrmHjtMFeX4QapFISL6wdE_F-gkL9aZVV4O4rjOnM4Fy-jNbs91wIrj3i1mxXLbFdtJidztXEn8Lj3qFsOY1F4zlPyqc62LzlLPXYUVsFmjvKspLQtHd9nVdvoCH6kIZtPObjfg6g1bkR2MWvTIoxoEb_pwo7M6JUeYProOY29U9k0JQ7KXIN4MmaOfv7zdBrbcSIe46xlMyql3T5IDFLfgoxfbPtP3JQ3eR">
</button>
<button class="w-20 h-24 md:w-24 md:h-32 bg-surface-container rounded-lg overflow-hidden border border-outline-variant hover:border-border-sage transition-colors snap-start focus:outline-none shrink-0 relative opacity-70 hover:opacity-100">
<img alt="Thumbnail 4" class="w-full h-full object-cover mix-blend-multiply" data-alt="An infographic-style photograph showing a small mound of premium roasted almonds next to a vintage brass nutritional scale on a light beige background. The scene is brightly lit with a clean, clinical yet warm aesthetic to emphasize health benefits and premium sourcing." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCXTs1A0-ofxRwFIDYz0SFhGMrt_CkACZD7q-XJ8HZ4iToKZgEoXsQXvPIUTnRifWmOG6Ygpeg5lZiGw3aJyt46iMH-JQbAEzzhPo2SMghyEVgn8P7GDrNXmappkP1m9B5MQOwgeixVA8i7obUxzcjX9G5E7z8YVoRbM3Pjs4RFkF8qKiYvzAiOh6pxdxq4hhlAtnOFyOCHwfbxfqV3-EH72xh_3-kkDLeHYz4JMfkU71kVpasvx8mE">
</button>
</div>
</div>
<!-- Right: Sticky Buy Box (Span 5) -->
<div class="md:col-span-5 flex flex-col gap-6 md:sticky md:top-24">
<!-- Header Section -->
<div class="flex flex-col gap-2 border-b border-surface-variant pb-6">
<span class="font-label-caps text-label-caps tracking-widest text-text-soft uppercase">Happilo Premium</span>
<h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-text-ink leading-tight">Premium Californian Roasted Almonds</h1>
<!-- Ratings -->
<div class="flex items-center gap-2 mt-1">
<div class="flex text-secondary-container">
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star_half</span>
</div>
<a class="font-body-sm text-body-sm text-primary underline hover:text-secondary transition-colors" href="#reviews">(1,284 Reviews)</a>
</div>
</div>
<!-- Price Section -->
<div class="flex items-baseline gap-3">
<span class="font-price-lg text-price-lg text-text-ink">₹499.00</span>
<span class="font-price-mrp text-price-mrp text-outline line-through">₹750.00</span>
<span class="font-label-caps text-label-caps text-primary bg-primary-fixed-dim/20 px-2 py-1 rounded-md ml-auto">Inclusive of all taxes</span>
</div>
<!-- Weight Selector (Chips) -->
<div class="flex flex-col gap-3">
<span class="font-title-md text-title-md text-text-ink">Select Weight</span>
<div class="flex flex-wrap gap-3">
<button class="px-5 py-2 rounded-full border border-outline-variant font-body-sm text-body-sm text-on-surface-variant hover:border-primary transition-all focus:outline-none min-h-[touch-target]">100g</button>
<button class="px-5 py-2 rounded-full border border-primary bg-primary text-on-primary font-body-sm text-body-sm shadow-sm transition-all focus:outline-none min-h-[touch-target]">200g</button>
<button class="px-5 py-2 rounded-full border border-outline-variant font-body-sm text-body-sm text-on-surface-variant hover:border-primary transition-all focus:outline-none min-h-[touch-target]">500g</button>
<button class="px-5 py-2 rounded-full border border-outline-variant font-body-sm text-body-sm text-on-surface-variant hover:border-primary transition-all focus:outline-none min-h-[touch-target]">1kg</button>
</div>
</div>
<!-- Action Buttons (Stepper & Add to Cart) -->
<div class="flex gap-4 mt-2">
<!-- Quantity Stepper -->
<div class="flex items-center justify-between border border-outline-variant rounded-lg bg-surface-container-lowest w-32 h-[44px] overflow-hidden">
<button aria-label="Decrease quantity" class="w-10 h-full flex items-center justify-center text-text-soft hover:bg-surface-container transition-colors focus:outline-none active:bg-surface-variant">
<span class="material-symbols-outlined text-[20px]">remove</span>
</button>
<span class="font-body-lg text-body-lg text-text-ink font-semibold">1</span>
<button aria-label="Increase quantity" class="w-10 h-full flex items-center justify-center text-text-soft hover:bg-surface-container transition-colors focus:outline-none active:bg-surface-variant">
<span class="material-symbols-outlined text-[20px]">add</span>
</button>
</div>
<!-- Primary Add to Cart -->
<button class="flex-1 bg-secondary-container text-text-ink font-title-md text-title-md rounded-lg h-[44px] shadow-sm hover:brightness-105 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">shopping_bag</span>
                    Add to Cart
                </button>
</div>
<button class="w-full flex items-center justify-center gap-2 py-3 border border-primary text-primary font-title-md text-title-md rounded-lg h-[44px] hover:bg-primary/5 transition-colors">
<span class="material-symbols-outlined">favorite_border</span>
                Add to Wishlist
            </button>
<!-- Quality Seals (Row of 4) -->
<div class="flex justify-between items-center mt-6 py-6 border-t border-surface-variant">
<div class="flex flex-col items-center gap-2 group cursor-help">
<div class="w-14 h-14 rounded-full quality-seal bg-surface-container flex items-center justify-center transition-colors">
<span class="material-symbols-outlined text-primary text-[28px] group-hover:scale-110 transition-transform">eco</span>
</div>
<span class="font-label-caps text-label-caps text-text-soft text-center w-16 leading-tight">100%<br>Natural</span>
</div>
<div class="flex flex-col items-center gap-2 group cursor-help">
<div class="w-14 h-14 rounded-full quality-seal bg-surface-container flex items-center justify-center transition-colors">
<span class="material-symbols-outlined text-primary text-[28px] group-hover:scale-110 transition-transform">grain</span>
</div>
<span class="font-label-caps text-label-caps text-text-soft text-center w-16 leading-tight">Gluten<br>Free</span>
</div>
<div class="flex flex-col items-center gap-2 group cursor-help">
<div class="w-14 h-14 rounded-full quality-seal bg-surface-container flex items-center justify-center transition-colors">
<span class="material-symbols-outlined text-primary text-[28px] group-hover:scale-110 transition-transform">verified</span>
</div>
<span class="font-label-caps text-label-caps text-text-soft text-center w-16 leading-tight">Premium<br>Sourced</span>
</div>
<div class="flex flex-col items-center gap-2 group cursor-help">
<div class="w-14 h-14 rounded-full quality-seal bg-surface-container flex items-center justify-center transition-colors">
<span class="material-symbols-outlined text-primary text-[28px] group-hover:scale-110 transition-transform">favorite</span>
</div>
<span class="font-label-caps text-label-caps text-text-soft text-center w-16 leading-tight">Heart<br>Healthy</span>
</div>
</div>
<!-- Accordion Details (Below Fold on Mobile, Sticky continuation on Desktop) -->
<div class="flex flex-col gap-0 border-t border-surface-variant mt-2">
<!-- Product Details Accordion -->
<details class="group border-b border-surface-variant" open="">
<summary class="flex justify-between items-center py-4 cursor-pointer list-none font-title-md text-title-md text-text-ink hover:text-primary transition-colors focus:outline-none">
                        Product Details
                        <span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform duration-300">expand_more</span>
</summary>
<div class="pb-4 font-body-sm text-body-sm text-text-soft leading-relaxed text-balance">
<p>Experience the crunch of our premium, hand-picked Californian almonds. Slowly dry-roasted to perfection without a single drop of oil, these nuts retain their natural goodness while developing a rich, deeply satisfying flavor profile. Packed with essential nutrients, they are the perfect guilt-free snack to fuel your active lifestyle.</p>
<ul class="list-disc pl-5 mt-2 space-y-1">
<li>Zero Cholesterol &amp; Trans Fat</li>
<li>High in Dietary Fiber</li>
<li>Rich source of Antioxidants &amp; Vitamin E</li>
</ul>
</div>
</details>
<!-- Nutrition & Ingredients Accordion -->
<details class="group border-b border-surface-variant">
<summary class="flex justify-between items-center py-4 cursor-pointer list-none font-title-md text-title-md text-text-ink hover:text-primary transition-colors focus:outline-none">
                        Nutrition &amp; Ingredients
                        <span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform duration-300">expand_more</span>
</summary>
<div class="pb-4 font-body-sm text-body-sm text-text-soft leading-relaxed">
<p class="font-semibold mb-2">Ingredients: 100% Californian Almonds.</p>
<div class="bg-surface-container-low p-4 rounded-lg border border-outline-variant mt-3">
<h4 class="font-label-caps text-label-caps mb-2 text-text-ink">Nutritional Value (per 100g)</h4>
<div class="grid grid-cols-2 gap-2 text-sm">
<div class="flex justify-between border-b border-surface-variant pb-1"><span>Energy</span> <span class="font-semibold">579 kcal</span></div>
<div class="flex justify-between border-b border-surface-variant pb-1"><span>Protein</span> <span class="font-semibold">21.15g</span></div>
<div class="flex justify-between border-b border-surface-variant pb-1"><span>Carbohydrates</span> <span class="font-semibold">21.55g</span></div>
<div class="flex justify-between border-b border-surface-variant pb-1"><span>Dietary Fiber</span> <span class="font-semibold">12.50g</span></div>
<div class="flex justify-between pb-1"><span>Total Fat</span> <span class="font-semibold">49.93g</span></div>
</div>
</div>
</div>
</details>
<!-- Reviews Accordion -->
<details class="group" id="reviews">
<summary class="flex justify-between items-center py-4 cursor-pointer list-none font-title-md text-title-md text-text-ink hover:text-primary transition-colors focus:outline-none">
                        Customer Reviews (1,284)
                        <span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform duration-300">expand_more</span>
</summary>
<div class="pb-4 pt-2">
<!-- Single Review Sample -->
<div class="flex flex-col gap-2 mb-4 bg-surface-container-lowest p-4 rounded-lg border border-surface-variant shadow-sm">
<div class="flex justify-between items-start">
<div>
<h5 class="font-body-sm font-semibold text-text-ink">Excellent Quality!</h5>
<div class="flex text-secondary-container mt-1">
<span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
