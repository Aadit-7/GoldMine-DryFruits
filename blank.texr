</nav>
<div class="flex items-center gap-4 text-primary">
<div class="relative hidden md:flex items-center">
<span class="material-symbols-outlined absolute left-2 text-on-surface-variant" style="font-variation-settings: 'FILL' 0;">search</span>
<input class="bg-surface-container-low border border-outline-variant rounded-full pl-9 pr-4 py-2 text-sm focus:outline-none focus:border-primary-fixed focus:ring-1 focus:ring-primary-fixed transition-all w-48" placeholder="Search..." type="text">
</div>
<button class="material-symbols-outlined hover:text-secondary-container transition-colors cursor-pointer active:scale-95" data-icon="search" style="font-variation-settings: 'FILL' 0;">search</button>
<button class="material-symbols-outlined hover:text-secondary-container transition-colors cursor-pointer active:scale-95" data-icon="favorite" style="font-variation-settings: 'FILL' 0;">favorite</button>
<button class="material-symbols-outlined hover:text-secondary-container transition-colors cursor-pointer active:scale-95" data-icon="shopping_cart" style="font-variation-settings: 'FILL' 0;">shopping_cart</button>
<button class="material-symbols-outlined hover:text-secondary-container transition-colors cursor-pointer active:scale-95 hidden md:block" data-icon="person" style="font-variation-settings: 'FILL' 0;">person</button>
</div>
</div>
</header>
<!-- Main Content Canvas -->
<main class="flex-grow w-full max-w-[1200px] mx-auto px-container-margin py-section-gap grid grid-cols-1 md:grid-cols-12 gap-section-gap items-start">
